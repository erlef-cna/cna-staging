#!/usr/bin/env elixir
#
# gen-affected - generate the `affected` and `cpeApplicability` JSON blocks
# for a CVE record from an intro commit, optional fix commits, and source paths.
#
# Supported platforms: `erlang`, `elixir`, `hex`. The subcommand selects the
# platform. `gleam` will be added later.
#
# Usage:
#   scripts/gen-affected <platform> \
#       --intro <SHA> \
#       [--fix <SHA>]... \
#       --path <repo-relative-path> [--path ...] \
#       [--module <name>]... \
#       [--routine <module:fun/arity>]...
#
# Output: {"affected": [...], "cpeApplicability": [...]} on stdout. Caller
# merges into the record manually (cve-formatter will pretty-format on save).

Mix.install([{:purl, "~> 0.4"}])

defmodule GenAffected do
  @scripts_dir __DIR__

  defp halt_fail(m), do: (IO.puts(:stderr, m); System.halt(1))
  defp script(name), do: Path.join(@scripts_dir, name)

  # ---- platform config -------------------------------------------------------
  # Each platform pins the repo, CPE, tag conventions, and the small set of
  # platform-specific helpers (path -> app, app version resolver, ...). The
  # rest of the pipeline is shared.
  defp config(:erlang, _opts) do
    %{
      repo: "https://github.com/erlang/otp.git",
      repo_url: "https://github.com/erlang/otp",
      cpe: "cpe:2.3:a:erlang:erlang\\/otp:*:*:*:*:*:*:*:*",
      vendor: "Erlang",
      product: "OTP",
      github_package_name: "erlang/otp",
      github_package_url: github_purl("erlang", "otp"),
      version_type: "otp",
      github_versions: :otp_and_git,
      tag_prefixes: [{"OTP-", :modern}, {"OTP_R", :legacy}],
      pre_releases_are_stable: false,
      group_key: &otp_major/1,
      group_label: fn k -> "#{k}.0" end,
      todo_no_fixes: :latest_3_majors,
      app_version_resolver: :otp_versions_table,
      path_to_app: &erlang_path_to_app/1,
      path_strip: &erlang_path_strip/1,
      legacy_intro?: &erlang_legacy_intro?/1,
      build_entries: &default_build_entries/1,
      app_entry_extras: fn app ->
        %{
          "packageName" => app,
          "packageURL" => otp_app_purl(app, "https://github.com/erlang/otp")
        }
      end
    }
  end

  defp config(:elixir, _opts) do
    %{
      repo: "https://github.com/elixir-lang/elixir.git",
      repo_url: "https://github.com/elixir-lang/elixir",
      cpe: "cpe:2.3:a:elixir-lang:elixir:*:*:*:*:*:*:*:*",
      vendor: "elixir-lang",
      product: "elixir",
      github_package_name: "elixir-lang/elixir",
      github_package_url: github_purl("elixir-lang", "elixir"),
      version_type: "semver",
      github_versions: :git_only,
      tag_prefixes: [{"v", :modern}],
      pre_releases_are_stable: true,
      # Elixir releases are versioned per minor; backports go to minor lines.
      group_key: &elixir_minor/1,
      group_label: fn {maj, min} -> "#{maj}.#{min}.0" end,
      todo_no_fixes: :single_todo,
      app_version_resolver: :identity,
      path_to_app: &elixir_path_to_app/1,
      path_strip: &elixir_path_strip/1,
      legacy_intro?: fn _ -> false end,
      build_entries: &default_build_entries/1,
      app_entry_extras: fn app ->
        %{
          "packageName" => app,
          "packageURL" => otp_app_purl(app, "https://github.com/elixir-lang/elixir")
        }
      end
    }
  end

  defp config(:hex, opts) do
    package = opts.package || halt_fail("error: --package <name> is required for hex")
    repo_url = opts.repo || halt_fail("error: --repo <github-url> is required for hex")
    repo_url = String.replace_suffix(repo_url, ".git", "")
    {owner, name} = parse_github_repo(repo_url)

    %{
      repo: repo_url <> ".git",
      repo_url: repo_url,
      cpe: "cpe:2.3:a:#{owner}:#{package}:*:*:*:*:*:*:*:*",
      vendor: owner,
      product: package,
      github_package_name: "#{owner}/#{name}",
      github_package_url: github_purl(owner, name),
      version_type: "semver",
      github_versions: :git_only,
      # Accept both `vX.Y.Z` and `X.Y.Z` tags. The `v` prefix matches first; bare
      # tags fall through and are validated as semver in classify_tag.
      tag_prefixes: [{"v", :modern}, {"", :modern}],
      pre_releases_are_stable: true,
      # Hex packages are semver; group backports by minor like Elixir.
      group_key: &hex_minor/1,
      group_label: fn {maj, min} -> "#{maj}.#{min}.0" end,
      todo_no_fixes: :single_todo,
      app_version_resolver: :identity,
      path_to_app: fn _ -> package end,
      path_strip: fn p -> p end,
      legacy_intro?: fn _ -> false end,
      build_entries: &default_build_entries/1,
      app_entry_extras: fn _app ->
        %{
          "collectionURL" => "https://repo.hex.pm",
          "packageName" => package,
          "packageURL" => hex_purl(package)
        }
      end
    }
  end

  defp config(:gleam, _opts) do
    %{
      repo: "https://github.com/gleam-lang/gleam.git",
      repo_url: "https://github.com/gleam-lang/gleam",
      cpe: "cpe:2.3:a:gleam-lang:gleam:*:*:*:*:*:*:*:*",
      vendor: "Gleam",
      product: "Gleam",
      github_package_name: "gleam-lang/gleam",
      github_package_url: github_purl("gleam-lang", "gleam"),
      version_type: "semver",
      github_versions: :git_only,
      tag_prefixes: [{"v", :modern}],
      pre_releases_are_stable: true,
      # Gleam follows semver per minor.
      group_key: &elixir_minor/1,
      group_label: fn {maj, min} -> "#{maj}.#{min}.0" end,
      todo_no_fixes: :single_todo,
      app_version_resolver: :identity,
      path_to_app: fn _ -> "gleam" end,
      path_strip: fn p -> p end,
      legacy_intro?: fn _ -> false end,
      build_entries: &gleam_build_entries/1,
      app_entry_extras: fn _ -> %{} end
    }
  end

  # ---- purl helpers ----------------------------------------------------------
  defp github_purl(owner, name) do
    Purl.to_string(struct!(Purl, type: "github", namespace: [owner], name: name))
  end

  defp hex_purl(name) do
    Purl.to_string(struct!(Purl, type: "hex", name: name))
  end

  defp otp_app_purl(app, repo_url) do
    Purl.to_string(
      struct!(Purl,
        type: "otp",
        name: app,
        qualifiers: %{
          "repository_url" => repo_url,
          "vcs_url" => "git #{repo_url}.git"
        }
      )
    )
  end

  defp sid_gleam_purl do
    Purl.to_string(struct!(Purl, type: "sid", namespace: ["gleam.run"], name: "gleam"))
  end

  defp oci_gleam_purl do
    Purl.to_string(
      struct!(Purl,
        type: "oci",
        name: "gleam",
        qualifiers: %{"repository_url" => "ghcr.io/gleam-lang"}
      )
    )
  end

  defp parse_github_repo(url) do
    case Regex.run(~r{github\.com[/:]([^/]+)/([^/]+?)(?:\.git)?/?$}, url) do
      [_, owner, name] -> {owner, name}
      _ -> halt_fail("error: cannot parse GitHub owner/repo from #{url}")
    end
  end

  # ---- tag parsing -----------------------------------------------------------
  defp tags_containing(cfg, sha) do
    case System.cmd(script("refs-containing"), [cfg.repo, sha], stderr_to_stdout: true) do
      {out, 0} ->
        out
        |> String.split("\n", trim: true)
        |> Enum.flat_map(fn line ->
          case String.split(line, ":", parts: 2) do
            ["tag", name] -> classify_tag(cfg, name)
            _ -> []
          end
        end)

      {out, _} ->
        IO.write(:stderr, out)
        halt_fail("error: refs-containing failed for #{sha}")
    end
  end

  defp classify_tag(cfg, name) do
    Enum.find_value(cfg.tag_prefixes, [], fn {prefix, kind} ->
      if String.starts_with?(name, prefix) do
        bare = String.replace_prefix(name, prefix, "")
        if version_like?(kind, bare), do: [{kind, name, bare}]
      end
    end)
  end

  # A bare tag must start with a digit to count as a release version. Stops the
  # hex platform's empty-prefix fallback from sweeping in non-version tags like
  # "release-candidate" or "latest".
  defp version_like?(:legacy, _), do: true
  defp version_like?(:modern, <<c, _::binary>>) when c in ?0..?9, do: true
  defp version_like?(_, _), do: false

  # Earliest release tag containing the SHA. Legacy tags (OTP_R...) come from
  # an era before semver and are chronologically earliest by definition, so we
  # pick them whenever they're present. For modern tags, whether pre-releases
  # count as "shipped" depends on the platform: hex/elixir/gleam GHSAs cover
  # pre-releases (semver ecosystem norm), so a SHA in both v1.6.0-rc.0 and
  # v1.6.17 is reported as v1.6.0-rc.0. OTP does not consider RCs stable, so
  # pre-release tags are skipped and the earliest real release wins.
  defp earliest_tag(cfg, sha) do
    tags = tags_containing(cfg, sha)
    if tags == [], do: halt_fail("error: no release tag in #{cfg.repo} contains #{sha}")

    legacy = Enum.filter(tags, fn {kind, _, _} -> kind == :legacy end)
    modern = Enum.filter(tags, fn {kind, _, _} -> kind == :modern end)

    modern_candidates =
      if cfg.pre_releases_are_stable,
        do: modern,
        else: Enum.filter(modern, fn {_, _, v} -> not pre_release?(v) end)

    cond do
      legacy != [] ->
        {_, name, _} = Enum.min_by(legacy, fn {_, _, v} -> v end)
        name

      modern_candidates != [] ->
        {_, name, _} = Enum.min_by(modern_candidates, fn {_, _, v} -> parse_version(v) end)
        name

      true ->
        # Fallback: only pre-release tags exist and the platform excludes
        # them. Report the earliest pre-release rather than failing.
        {_, name, _} = Enum.min_by(modern, fn {_, _, v} -> parse_version(v) end)
        name
    end
  end

  defp pre_release?(version), do: String.contains?(version, "-")

  # Strip the platform-specific prefix from a tag to yield the bare version.
  defp strip_prefix(cfg, tag) do
    Enum.find_value(cfg.tag_prefixes, tag, fn {prefix, kind} ->
      if String.starts_with?(tag, prefix) do
        bare = String.replace_prefix(tag, prefix, "")
        # Legacy OTP tags use "OTP_R<series>" -> render as "R<series>".
        if kind == :legacy, do: "R" <> bare, else: bare
      end
    end)
  end

  defp parse_version(tag) do
    {numeric, suffix} =
      case String.split(tag, "-", parts: 2) do
        [n] -> {n, ""}
        [n, s] -> {n, s}
      end

    nums =
      numeric
      |> String.split(".")
      |> Enum.map(fn p ->
        case Integer.parse(p) do
          {i, ""} -> i
          _ -> 0
        end
      end)

    suffix_rank = if suffix == "", do: 1, else: 0
    {nums, suffix_rank, suffix}
  end

  # ---- platform: erlang ------------------------------------------------------
  defp otp_major("OTP-" <> rest), do: rest |> parse_version() |> elem(0) |> List.first()
  defp otp_major("OTP_R" <> _), do: nil

  defp erlang_path_to_app("erts/" <> _), do: "erts"
  defp erlang_path_to_app("lib/" <> rest), do: rest |> String.split("/", parts: 2) |> List.first()
  defp erlang_path_to_app(path), do: halt_fail("error: cannot map path #{path} to an OTP app (expected erts/... or lib/<app>/...)")

  defp erlang_path_strip("erts/" <> rest), do: rest
  defp erlang_path_strip("lib/" <> rest) do
    case String.split(rest, "/", parts: 2) do
      [_app, tail] -> tail
      _ -> rest
    end
  end

  defp erlang_legacy_intro?("OTP_R" <> _), do: true
  defp erlang_legacy_intro?(_), do: false

  # ---- platform: elixir ------------------------------------------------------
  defp elixir_minor("v" <> rest) do
    case parse_version(rest) |> elem(0) do
      [maj, min | _] -> {maj, min}
      [maj] -> {maj, 0}
      _ -> nil
    end
  end
  defp elixir_minor(_), do: nil

  defp elixir_path_to_app("lib/" <> rest), do: rest |> String.split("/", parts: 2) |> List.first()
  defp elixir_path_to_app(path), do: halt_fail("error: cannot map path #{path} to an Elixir sub-app (expected lib/<app>/...)")

  defp elixir_path_strip("lib/" <> rest) do
    case String.split(rest, "/", parts: 2) do
      [_app, tail] -> tail
      _ -> rest
    end
  end

  # ---- platform: hex ---------------------------------------------------------
  # Hex packages are semver, possibly with a leading "v" on tags. Group key
  # uses {major, minor} so backports across release lines stay separable.
  defp hex_minor(tag) do
    bare = String.replace_prefix(tag, "v", "")

    case parse_version(bare) |> elem(0) do
      [maj, min | _] -> {maj, min}
      [maj] -> {maj, 0}
      _ -> nil
    end
  end

  # ---- app version resolver (otp_versions.table for Erlang, identity for Elixir)
  # Returns the app's version in a given release tag.
  defp app_version(:otp_versions_table, tag, app) do
    case System.cmd(script("otp-versions"), ["release", tag, app], stderr_to_stdout: true) do
      {out, 0} -> {:ok, String.trim(out)}
      _ -> :error
    end
  end

  defp app_version(:identity, tag, _app) do
    # Elixir sub-apps share the elixir release version; strip the "v" prefix.
    {:ok, String.replace_prefix(tag, "v", "")}
  end

  defp app_version!(cfg, tag, app) do
    case app_version(cfg.app_version_resolver, tag, app) do
      {:ok, v} -> v
      :error -> halt_fail("error: cannot resolve #{app}'s version in #{tag}")
    end
  end

  # The app's introducing version. If the app shipped in intro_tag, that's it.
  # Otherwise (Erlang extraction case, e.g. tftp split out of inets) walk
  # forward through releases until the app first appears.
  defp first_release_shipping_app(cfg, intro_tag, app) do
    case app_version(cfg.app_version_resolver, intro_tag, app) do
      {:ok, v} ->
        {v, intro_tag}

      :error ->
        # Only meaningful for the otp_versions.table resolver.
        all = list_releases(cfg)
        intro_v = parse_version(strip_prefix(cfg, intro_tag))

        forward =
          all
          |> Enum.filter(fn r -> parse_version(strip_prefix(cfg, r)) >= intro_v end)
          |> Enum.reverse()

        case Enum.find_value(forward, fn r ->
               case app_version(cfg.app_version_resolver, r, app) do
                 {:ok, v} -> {v, r}
                 :error -> nil
               end
             end) do
          {v, r} -> {v, r}
          nil -> halt_fail("error: no release at or after #{intro_tag} ships #{app}")
        end
    end
  end

  defp list_releases(%{app_version_resolver: :otp_versions_table}) do
    case System.cmd(script("otp-versions"), ["list-releases"], stderr_to_stdout: true) do
      {out, 0} -> String.split(out, "\n", trim: true)
      _ -> halt_fail("error: otp-versions list-releases failed")
    end
  end

  defp list_releases(_), do: []

  # ---- per-major resolution --------------------------------------------------
  defp resolve_fixes(cfg, fixes) do
    fixes
    |> Enum.map(fn sha -> {sha, earliest_tag(cfg, sha)} end)
    |> Enum.group_by(fn {_, tag} -> cfg.group_key.(tag) end)
    |> Map.new(fn {key, pairs} ->
      {sha, tag} =
        Enum.min_by(pairs, fn {_, t} -> parse_version(strip_prefix(cfg, t)) end)

      {key, {tag, sha}}
    end)
  end

  defp per_major_entries(cfg, fixes, intro_tag, no_patch?) do
    cond do
      no_patch? ->
        # No patch will ever ship: a single open-ended range from intro forward.
        intro_key = cfg.group_key.(intro_tag)
        [%{key: intro_key, no_fix: true}]

      fixes == [] ->
        todo_entries(cfg, intro_tag)

      true ->
        resolve_fixes(cfg, fixes)
        |> Enum.sort_by(fn {k, _} -> sort_neg(k) end)
        |> Enum.map(fn {key, {fix_tag, fix_sha}} ->
          %{key: key, fix_tag: fix_tag, fix_sha: fix_sha, todo: false, no_fix: false}
        end)
    end
  end

  defp todo_entries(cfg, intro_tag) do
    case cfg.todo_no_fixes do
      :latest_3_majors ->
        intro_key = cfg.group_key.(intro_tag)

        # For Erlang, group_key returns the major int. Filter to majors >= intro_major.
        case System.cmd(script("otp-versions"), ["list-releases"], stderr_to_stdout: true) do
          {out, 0} ->
            out
            |> String.split("\n", trim: true)
            |> Enum.map(&cfg.group_key.(&1))
            |> Enum.uniq()
            |> Enum.filter(fn k -> intro_key == nil or k >= intro_key end)
            |> Enum.take(3)
            |> Enum.map(fn k ->
              %{key: k, fix_tag: "TODO#{k}", fix_sha: "TODO#{k}", todo: true, no_fix: false}
            end)

          _ ->
            halt_fail("error: otp-versions list-releases failed")
        end

      :single_todo ->
        # Elixir: a single TODO slot keyed by intro's minor (we can't predict
        # which minor will receive the fix).
        intro_key = cfg.group_key.(intro_tag)
        label = "TODO"

        [%{key: intro_key, fix_tag: label, fix_sha: label, todo: true, no_fix: false}]
    end
  end

  # Sort key for descending major/minor ordering. Handles both integer
  # (Erlang major) and {major, minor} tuple (Elixir).
  defp sort_neg(n) when is_integer(n), do: -n
  defp sort_neg({a, b}), do: {-a, -b}
  defp sort_neg(_), do: 0

  # ---- entry builders --------------------------------------------------------
  defp build_github_entry(cfg, intro_sha, intro_tag, per_major, paths, modules, routines) do
    intro_version = strip_prefix(cfg, intro_tag)

    otp_version =
      case per_major do
        [%{no_fix: true}] ->
          %{
            "lessThan" => "*",
            "status" => "affected",
            "version" => intro_version,
            "versionType" => cfg.version_type
          }

        [%{fix_tag: tag, todo: todo}] ->
          %{
            "lessThan" => if(todo, do: tag, else: strip_prefix(cfg, tag)),
            "status" => "affected",
            "version" => intro_version,
            "versionType" => cfg.version_type
          }

        _ ->
          %{
            "changes" => Enum.map(per_major, fn m ->
              %{"at" => if(m.todo, do: m.fix_tag, else: strip_prefix(cfg, m.fix_tag)),
                "status" => "unaffected"}
            end),
            "lessThan" => "*",
            "status" => "affected",
            "version" => intro_version,
            "versionType" => cfg.version_type
          }
      end

    git_version =
      case per_major do
        [%{no_fix: true}] ->
          %{
            "lessThan" => "*",
            "status" => "affected",
            "version" => intro_sha,
            "versionType" => "git"
          }

        [%{fix_sha: sha}] ->
          %{
            "lessThan" => sha,
            "status" => "affected",
            "version" => intro_sha,
            "versionType" => "git"
          }

        _ ->
          %{
            "changes" => Enum.map(per_major, fn m -> %{"at" => m.fix_sha, "status" => "unaffected"} end),
            "lessThan" => "*",
            "status" => "affected",
            "version" => intro_sha,
            "versionType" => "git"
          }
      end

    versions =
      case cfg.github_versions do
        :git_only -> [git_version]
        :otp_and_git -> [otp_version, git_version]
      end

    base_entry(paths, modules, routines)
    |> Map.merge(%{
      "collectionURL" => "https://github.com",
      "cpes" => [cfg.cpe],
      "packageName" => cfg.github_package_name,
      "packageURL" => cfg.github_package_url,
      "product" => cfg.product,
      "repo" => cfg.repo_url,
      "vendor" => cfg.vendor,
      "versions" => versions
    })
  end

  defp build_app_entry(cfg, app, intro_tag, per_major, paths, modules, routines) do
    {intro_app_version, _} = first_release_shipping_app(cfg, intro_tag, app)

    versions =
      case per_major do
        [%{no_fix: true}] ->
          [%{"lessThan" => "*",
             "status" => "affected", "version" => intro_app_version,
             "versionType" => cfg.version_type}]

        [%{todo: true, key: k}] ->
          [%{"lessThan" => "TODO#{format_key(k)}",
             "status" => "affected", "version" => intro_app_version,
             "versionType" => cfg.version_type}]

        [%{todo: false, fix_tag: tag}] ->
          [%{"lessThan" => app_version!(cfg, tag, app),
             "status" => "affected", "version" => intro_app_version,
             "versionType" => cfg.version_type}]

        _ ->
          changes =
            Enum.flat_map(per_major, fn m ->
              if m.todo do
                [%{"at" => "TODO#{format_key(m.key)}", "status" => "unaffected"}]
              else
                [%{"at" => app_version!(cfg, m.fix_tag, app), "status" => "unaffected"}]
              end
            end)

          [%{"changes" => changes, "lessThan" => "*",
             "status" => "affected", "version" => intro_app_version,
             "versionType" => cfg.version_type}]
      end

    relative_paths = Enum.map(paths, cfg.path_strip)

    base_entry(relative_paths, modules, routines)
    |> Map.merge(%{
      "cpes" => [cfg.cpe],
      "product" => cfg.product,
      "repo" => cfg.repo_url,
      "vendor" => cfg.vendor,
      "versions" => versions
    })
    |> Map.merge(cfg.app_entry_extras.(app))
  end

  defp format_key(k) when is_integer(k), do: "#{k}"
  defp format_key({maj, min}), do: "#{maj}.#{min}"
  defp format_key(_), do: ""

  defp base_entry(paths, modules, routines) do
    entry = %{
      "defaultStatus" => "unaffected",
      "programFiles" => paths
    }

    entry = if modules == [], do: entry, else: Map.put(entry, "modules", modules)

    if routines == [],
      do: entry,
      else: Map.put(entry, "programRoutines", Enum.map(routines, &%{"name" => &1}))
  end

  defp build_cpe_applicability(cfg, intro_tag, per_major) do
    drop_lower_on_lowest? = cfg.legacy_intro?.(intro_tag)
    intro_version = strip_prefix(cfg, intro_tag)

    # Chain the cpeMatches so they cover the intro->highest-fix range without
    # overlap or gaps:
    #   match 1: intro_version           -> fix 1
    #   match 2: (fix 1 minor + 1).0     -> fix 2
    #   match 3: (fix 2 minor + 1).0     -> fix 3
    #   ...
    # Sort ascending by group_key (oldest fix first), so each match's lower
    # bound is "where the previous fix's range ended".
    sorted = per_major |> Enum.sort_by(&sort_neg(&1.key)) |> Enum.reverse()
    lowest = List.first(sorted)

    {matches, _} =
      Enum.map_reduce(sorted, nil, fn m, prev ->
        match = %{"criteria" => cfg.cpe, "vulnerable" => true}

        match =
          cond do
            m.no_fix -> match
            m.todo -> Map.put(match, "versionEndExcluding", "TODO#{format_key(m.key)}")
            true -> Map.put(match, "versionEndExcluding", strip_prefix(cfg, m.fix_tag))
          end

        match =
          cond do
            drop_lower_on_lowest? and m == lowest ->
              match

            prev == nil ->
              Map.put(match, "versionStartIncluding", intro_version)

            true ->
              Map.put(match, "versionStartIncluding", cfg.group_label.(next_key(prev.key)))
          end

        {match, m}
      end)

    %{
      "nodes" => [%{"cpeMatch" => matches, "negate" => false, "operator" => "OR"}],
      "operator" => "AND"
    }
  end

  # Successor for group_key: integer -> +1, {maj, min} -> {maj, min+1}.
  defp next_key(k) when is_integer(k), do: k + 1
  defp next_key({maj, min}), do: {maj, min + 1}

  # ---- pipeline --------------------------------------------------------------
  defp run(cfg, opts) do
    intro = opts.intro || halt_fail("error: --intro <SHA> is required")
    paths = if opts.paths == [], do: halt_fail("error: at least one --path is required"), else: opts.paths
    fixes = opts.fixes
    modules = opts.modules
    routines = opts.routines
    no_patch? = opts.no_patch?

    if no_patch? and fixes != [] do
      halt_fail("error: --no-patch-will-be-provided is incompatible with --fix")
    end

    intro_tag = earliest_tag(cfg, intro)
    per_major = per_major_entries(cfg, fixes, intro_tag, no_patch?)

    ctx = %{
      cfg: cfg,
      intro_sha: intro,
      intro_tag: intro_tag,
      per_major: per_major,
      paths: paths,
      modules: modules,
      routines: routines
    }

    %{
      "affected" => cfg.build_entries.(ctx),
      "cpeApplicability" => [build_cpe_applicability(cfg, intro_tag, per_major)]
    }
  end

  # Default for erlang/elixir/hex: one entry per affected app + a github entry.
  defp default_build_entries(ctx) do
    %{cfg: cfg, intro_tag: intro_tag, per_major: per_major, paths: paths,
      modules: modules, routines: routines} = ctx

    paths_by_app = Enum.group_by(paths, cfg.path_to_app)
    apps = Map.keys(paths_by_app) |> Enum.sort()

    app_entries =
      Enum.map(apps, fn app ->
        build_app_entry(cfg, app, intro_tag, per_major, paths_by_app[app], modules, routines)
      end)

    github_entry =
      build_github_entry(cfg, ctx.intro_sha, intro_tag, per_major, paths, modules, routines)

    app_entries ++ [github_entry]
  end

  # Gleam compiler: sid entry (gleam.run) + github entry + oci entry.
  # The OCI image is published with a fixed matrix of variant tags; the
  # github entry stays git-only (we already have semver on the sid entry).
  defp gleam_build_entries(ctx) do
    %{cfg: cfg, intro_tag: intro_tag, per_major: per_major, paths: paths,
      modules: modules, routines: routines} = ctx

    sid_entry = build_gleam_sid_entry(cfg, intro_tag, per_major, paths, modules, routines)

    github_entry =
      build_github_entry(cfg, ctx.intro_sha, intro_tag, per_major, paths, modules, routines)

    oci_entry = build_gleam_oci_entry(cfg, intro_tag, per_major, paths, modules, routines)

    [sid_entry, github_entry, oci_entry]
  end

  # Fixed OCI tag variants published by the gleam-lang CI matrix. The image
  # tag is `v<semver>-<variant>`, generated per release for every variant.
  @gleam_oci_variants ~w(elixir erlang node elixir-slim erlang-slim node-slim
                         elixir-alpine erlang-alpine node-alpine scratch)

  defp build_gleam_sid_entry(cfg, intro_tag, per_major, paths, modules, routines) do
    intro_version = strip_prefix(cfg, intro_tag)

    versions =
      case per_major do
        [%{no_fix: true}] ->
          [%{"lessThan" => "*", "status" => "affected",
             "version" => intro_version, "versionType" => cfg.version_type}]

        [%{todo: true, key: k}] ->
          [%{"lessThan" => "TODO#{format_key(k)}", "status" => "affected",
             "version" => intro_version, "versionType" => cfg.version_type}]

        [%{todo: false, fix_tag: tag}] ->
          [%{"lessThan" => strip_prefix(cfg, tag), "status" => "affected",
             "version" => intro_version, "versionType" => cfg.version_type}]

        _ ->
          changes =
            Enum.map(per_major, fn m ->
              at = if m.todo, do: "TODO#{format_key(m.key)}", else: strip_prefix(cfg, m.fix_tag)
              %{"at" => at, "status" => "unaffected"}
            end)

          [%{"changes" => changes, "lessThan" => "*", "status" => "affected",
             "version" => intro_version, "versionType" => cfg.version_type}]
      end

    base_entry(paths, modules, routines)
    |> Map.merge(%{
      "cpes" => [cfg.cpe],
      "packageName" => "gleam",
      "packageURL" => sid_gleam_purl(),
      "product" => cfg.product,
      "vendor" => cfg.vendor,
      "versions" => versions
    })
  end

  defp build_gleam_oci_entry(cfg, intro_tag, per_major, paths, modules, routines) do
    intro_version = strip_prefix(cfg, intro_tag)

    versions =
      Enum.flat_map(@gleam_oci_variants, fn variant ->
        case per_major do
          [%{no_fix: true}] ->
            [%{"lessThan" => "*", "status" => "affected",
               "version" => "v#{intro_version}-#{variant}", "versionType" => "other"}]

          [%{todo: true, key: k}] ->
            [%{"lessThan" => "TODO#{format_key(k)}-#{variant}", "status" => "affected",
               "version" => "v#{intro_version}-#{variant}", "versionType" => "other"}]

          [%{todo: false, fix_tag: tag}] ->
            [%{"lessThan" => "v#{strip_prefix(cfg, tag)}-#{variant}", "status" => "affected",
               "version" => "v#{intro_version}-#{variant}", "versionType" => "other"}]

          _ ->
            changes =
              Enum.map(per_major, fn m ->
                at =
                  if m.todo,
                    do: "TODO#{format_key(m.key)}-#{variant}",
                    else: "v#{strip_prefix(cfg, m.fix_tag)}-#{variant}"

                %{"at" => at, "status" => "unaffected"}
              end)

            [%{"changes" => changes, "lessThan" => "*", "status" => "affected",
               "version" => "v#{intro_version}-#{variant}", "versionType" => "other"}]
        end
      end)

    base_entry(paths, modules, routines)
    |> Map.merge(%{
      "collectionURL" => "https://ghcr.io",
      "cpes" => [cfg.cpe],
      "packageName" => "gleam-lang/gleam",
      "packageURL" => oci_gleam_purl(),
      "product" => cfg.product,
      "vendor" => cfg.vendor,
      "versions" => versions
    })
  end

  # ---- arg parsing -----------------------------------------------------------
  defp parse_args(argv) do
    {opts, rest, invalid} =
      OptionParser.parse(argv,
        strict: [
          intro: :string,
          fix: :keep,
          path: :keep,
          module: :keep,
          routine: :keep,
          package: :string,
          repo: :string,
          no_patch_will_be_provided: :boolean,
          help: :boolean
        ],
        aliases: [h: :help]
      )

    unless invalid == [], do: halt_fail("error: unknown option: #{inspect(invalid)}")
    if Keyword.get(opts, :help), do: (usage(); System.halt(0))

    %{
      intro: Keyword.get(opts, :intro),
      fixes: Keyword.get_values(opts, :fix),
      paths: Keyword.get_values(opts, :path),
      modules: Keyword.get_values(opts, :module),
      routines: Keyword.get_values(opts, :routine),
      package: Keyword.get(opts, :package),
      repo: Keyword.get(opts, :repo),
      no_patch?: Keyword.get(opts, :no_patch_will_be_provided, false),
      rest: rest
    }
  end

  defp usage do
    IO.puts(:stderr, """
    usage:
      gen-affected <erlang|elixir> --intro <SHA> [--fix <SHA>]...
                                   --path <path> [--path ...]
                                   [--module <name>]... [--routine <module:fun/arity>]...
                                   [--no-patch-will-be-provided]

      gen-affected hex --package <name> --repo <github-url>
                       --intro <SHA> [--fix <SHA>]...
                       --path <path> [--path ...]
                       [--module <name>]... [--routine <module:fun/arity>]...
                       [--no-patch-will-be-provided]

      gen-affected gleam --intro <SHA> [--fix <SHA>]...
                         --path <path> [--path ...]
                         [--module <crate>]... [--routine <crate::fn>]...
                         [--no-patch-will-be-provided]

    --no-patch-will-be-provided emits open-ended ranges (lessThan "*", no
    versionEndExcluding) for advisories where no patch will ever ship (e.g.
    a retired/deprecated package). Cannot be combined with --fix.

    The gleam subcommand emits three affected entries (pkg:sid/gleam.run/gleam,
    pkg:github/gleam-lang/gleam, pkg:oci/gleam) and generates the OCI image
    variant matrix (elixir, erlang, node, *-slim, *-alpine, scratch).
    """)
  end

  def main(["erlang" | rest]), do: dispatch(:erlang, rest)
  def main(["elixir" | rest]), do: dispatch(:elixir, rest)
  def main(["hex" | rest]), do: dispatch(:hex, rest)
  def main(["gleam" | rest]), do: dispatch(:gleam, rest)
  def main(["--help"]), do: (usage(); System.halt(0))
  def main(["-h"]), do: (usage(); System.halt(0))
  def main([]), do: (usage(); System.halt(1))
  def main([cmd | _]), do: halt_fail("error: unknown subcommand #{inspect(cmd)} (supported: erlang, elixir, hex, gleam)")

  defp dispatch(platform, args) do
    opts = parse_args(args)
    result = run(config(platform, opts), opts)
    IO.puts(format_json(result))
  end

  defp format_json(term), do: pretty(term, 0)

  defp pretty(map, indent) when is_map(map) do
    keys = Map.keys(map) |> Enum.sort()
    inner = indent + 2
    pad = String.duplicate(" ", inner)
    close_pad = String.duplicate(" ", indent)

    body =
      keys
      |> Enum.map(fn k -> "#{pad}#{JSON.encode!(k)}: #{pretty(map[k], inner)}" end)
      |> Enum.join(",\n")

    if body == "", do: "{}", else: "{\n#{body}\n#{close_pad}}"
  end

  defp pretty(list, indent) when is_list(list) do
    inner = indent + 2
    pad = String.duplicate(" ", inner)
    close_pad = String.duplicate(" ", indent)

    body =
      list
      |> Enum.map(fn v -> "#{pad}#{pretty(v, inner)}" end)
      |> Enum.join(",\n")

    if body == "", do: "[]", else: "[\n#{body}\n#{close_pad}]"
  end

  defp pretty(other, _indent), do: JSON.encode!(other)
end

GenAffected.main(System.argv())
